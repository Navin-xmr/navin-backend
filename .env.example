# -----------------------------------------------------------------------------
# Navin Backend — environment template (alphabetized)
# See docs/environment-variables.md for the full implemented-vs-required matrix.
# -----------------------------------------------------------------------------

# Comma-separated browser origins allowed by CORS (empty = none beyond defaults)
ALLOWED_ORIGINS=http://localhost:3000

# Legacy single CORS origin fallback (* = allow all)
CORS_ORIGIN=*

# Deployed frontend base URL (invite + password-reset links)
FRONTEND_URL=http://localhost:5173

# JWT signing secret (required, min 32 characters)
JWT_SECRET=replace-this-with-a-strong-32-char-minimum-jwt-secret

# TOTP 2FA encryption key — 64 hex characters (32 bytes, AES-256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in development (falls back to JWT_SECRET hash); required in production.
TOTP_ENCRYPTION_KEY=

# Pino log level (optional; not validated in env.ts) — debug|info|warn|error
LOG_LEVEL=debug

# MongoDB connection string (required)
MONGO_URI=mongodb://127.0.0.1:27017/navin_dev
# docker compose runs Mongo with auth; override the defaults (navin / navin-dev-password):
# MONGO_INITDB_ROOT_USERNAME=navin
# MONGO_INITDB_ROOT_PASSWORD=change-me

# Runtime mode: development | test | production
NODE_ENV=development

# HTTP listen port
PORT=3000

# Redis URL for BullMQ, SSE, and caches
REDIS_URL=redis://127.0.0.1:6379

# --- SendGrid (optional email relay; preferred over raw SMTP when set) ---
SENDGRID_API_KEY=

# --- Sentry (optional; validated but SDK not wired yet — TODO) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Prometheus metrics (#1044). Endpoint is disabled unless METRICS_TOKEN is set (>=16 chars).
# API: GET /api/metrics. Workers: set METRICS_PORT to serve GET /metrics on that port.
# METRICS_TOKEN=
# METRICS_PORT=9464

# --- SMTP (optional email — used by src/services/email.service.ts) ---
SMTP_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PASS=smtp-password
SMTP_PORT=587
SMTP_USER=you@example.com

# --- S3 object storage (optional — for AWS S3, MinIO, etc.) ---
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_BUCKET=my-bucket
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- Storage provider selection ---
# Options: mock (default), s3, r2, cloudinary
# mock: Local development without cloud credentials
# s3: AWS S3 or S3-compatible (use S3_* vars above)
# r2: Cloudflare R2 (use S3_* vars, set S3_ENDPOINT to R2 URL)
# cloudinary: Cloudinary CDN (image-optimized)
STORAGE_PROVIDER=mock

# --- Cloudinary storage (optional — for image optimization) ---
CLOUDINARY_CLOUD_NAME=my-cloud
CLOUDINARY_API_KEY=my-api-key
CLOUDINARY_API_SECRET=my-api-secret

# --- Soroban / escrow ---
# Adapter to use for escrow/hash-emit operations.
# Options: simulated (default, no credentials needed) | soroban (live Soroban RPC)
SOROBAN_ADAPTER=simulated
# Required when SOROBAN_ADAPTER=soroban:
ESCROW_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2B
# Deployed contract ids (#995). Set per STELLAR_NETWORK; no defaults are guessed.
SHIPMENT_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2B
TOKEN_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2B
# NFT_CONTRACT_ID is optional; only needed for NFT settlement.
# NFT_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2B
# Optional overrides — otherwise derived from STELLAR_NETWORK below.
SOROBAN_RPC_URL=https://soroban-rpc.example.com
# SOROBAN_NETWORK_PASSPHRASE="Test Network ; global/infrastructure/explicitly managed"
# Chain submission retry (timeouts only) — attempts include the first
# CHAIN_SUBMIT_MAX_ATTEMPTS=3
# CHAIN_SUBMIT_BACKOFF_MS=500
# CHAIN_SUBMIT_BACKOFF_MAX_MS=8000
# Read-only on-chain checks before signing; needs the contract view functions in docs/chain-interface.md
# CHAIN_PREFLIGHT_ENABLED=false
# CHAIN_PREFLIGHT_CHECKS=initialized,roles,whitelist,suspension,token_decimals
# Ledger confirmations required before an anchored event is marked verified (#1058)
CHAIN_CONFIRMATIONS_TESTNET=3
CHAIN_CONFIRMATIONS_PUBLIC=3
# --- Stellar ---
# Network: testnet | public — also selects the default Horizon/Soroban RPC URLs below
STELLAR_NETWORK=testnet
# Horizon signing secret (required for anchoring jobs)
STELLAR_SECRET_KEY=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# HMAC secret for /api/webhooks/stellar (min 16 chars)
STELLAR_WEBHOOK_SECRET=replace-this-with-a-strong-random-secret
# Optional — overrides the Horizon URL derived from STELLAR_NETWORK
# HORIZON_URL=https://horizon-testnet.stellar.org

# --- Twilio SMS (optional — TODO SMS OTP client; see #364) ---
TWILIO_FROM=+15551234567
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your-twilio-auth-token
