# -----------------------------------------------------------------------------
# Navin Backend — Docker Compose environment template
# Copy this file to .env.docker and fill in the values.
# DO NOT commit .env.docker to version control.
# -----------------------------------------------------------------------------

# --- MongoDB authentication ---
# Required for docker-compose.yml MongoDB auth
MONGO_INITDB_ROOT_USERNAME=navin_admin
MONGO_INITDB_ROOT_PASSWORD=change-this-strong-password

# MongoDB connection URI with credentials for the app services
# Format: mongodb://username:password@host:port/database?authSource=admin
MONGO_URI=mongodb://navin_admin:change-this-strong-password@mongo:27017/navin_dev?authSource=admin

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT ---
# Must be at least 32 characters
JWT_SECRET=replace-this-with-a-strong-32-char-minimum-jwt-secret

# --- Stellar ---
STELLAR_NETWORK=testnet
# Horizon signing secret (required for anchoring jobs)
STELLAR_SECRET_KEY=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# HMAC secret for /api/webhooks/stellar (min 16 chars)
STELLAR_WEBHOOK_SECRET=replace-this-with-a-strong-random-secret

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
CORS_ORIGIN=*

# --- Optional: Email (SendGrid preferred) ---
SENDGRID_API_KEY=

# --- Optional: SMTP ---
SMTP_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PASS=smtp-password
SMTP_PORT=587
SMTP_USER=you@example.com

# --- Optional: S3 / Object Storage ---
S3_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_SECRET_KEY=
STORAGE_PROVIDER=mock

# --- Optional: Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: Soroban / Escrow ---
ESCROW_CONTRACT_ID=
SOROBAN_RPC_URL=

# --- Optional: Twilio SMS ---
TWILIO_FROM=
TWILIO_SID=
TWILIO_TOKEN=

# --- Optional: Sentry ---
SENTRY_DSN=

# --- Logging ---
LOG_LEVEL=info

# --- TOTP 2FA ---
# 64 hex characters (32 bytes, AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=