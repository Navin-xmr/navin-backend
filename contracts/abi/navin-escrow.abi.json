{
  "spec_version": "2.1.0",
  "contract": "navin-escrow",
  "source": "https://github.com/Navin-xmr/navin-contracts",
  "functions": {
    "anchor": {
      "auth": "actor",
      "inputs": [
        { "name": "shipment_id", "type": "Symbol" },
        { "name": "data_hash", "type": "BytesN<32>" },
        { "name": "actor", "type": "Address" }
      ]
    },
    "init_escrow": {
      "auth": "payer",
      "inputs": [
        { "name": "payment_id", "type": "Symbol" },
        { "name": "shipment_id", "type": "Symbol" },
        { "name": "payer", "type": "Address" },
        { "name": "payee", "type": "Address" },
        { "name": "token", "type": "Address" },
        { "name": "amount", "type": "i128" }
      ]
    },
    "release_escrow": {
      "auth": "caller",
      "inputs": [
        { "name": "caller", "type": "Address" },
        { "name": "shipment_id", "type": "Symbol" }
      ]
    },
    "create_shipment": {
      "auth": "sender",
      "inputs": [
        { "name": "sender", "type": "Address" },
        { "name": "receiver", "type": "Address" },
        { "name": "carrier", "type": "Address" },
        { "name": "data_hash", "type": "BytesN<32>" },
        { "name": "payment_milestones", "type": "Vec<i128>" },
        { "name": "deadline", "type": "u64" }
      ],
      "returns": "u64"
    },
    "raise_dispute": {
      "auth": "caller",
      "inputs": [
        { "name": "caller", "type": "Address" },
        { "name": "shipment_id", "type": "Symbol" },
        { "name": "reason_hash", "type": "BytesN<32>" }
      ]
    },
    "resolve_dispute": {
      "auth": "admin",
      "inputs": [
        { "name": "admin", "type": "Address" },
        { "name": "shipment_id", "type": "Symbol" },
        { "name": "outcome", "type": "Symbol" }
      ]
    },
    "add_company": {
      "auth": "admin",
      "inputs": [
        { "name": "admin", "type": "Address" },
        { "name": "company", "type": "Address" }
      ]
    },
    "add_carrier": {
      "auth": "admin",
      "inputs": [
        { "name": "admin", "type": "Address" },
        { "name": "company", "type": "Address" },
        { "name": "carrier", "type": "Address" }
      ]
    },
    "add_carrier_to_whitelist": {
      "auth": "admin",
      "inputs": [
        { "name": "admin", "type": "Address" },
        { "name": "company", "type": "Address" },
        { "name": "carrier", "type": "Address" }
      ]
    }
  }
}
