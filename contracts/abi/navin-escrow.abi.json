{
  "spec_version": "2.2.0",
  "contract": "navin-escrow",
  "source": "https://github.com/Navin-xmr/navin-contracts",
  "functions": {
    "anchor": {
      "auth": "actor",
      "inputs": [
        {
          "name": "shipment_id",
          "type": "Symbol"
        },
        {
          "name": "data_hash",
          "type": "BytesN<32>"
        },
        {
          "name": "actor",
          "type": "Address"
        }
      ]
    },
    "init_escrow": {
      "auth": "payer",
      "inputs": [
        {
          "name": "payment_id",
          "type": "Symbol"
        },
        {
          "name": "shipment_id",
          "type": "Symbol"
        },
        {
          "name": "payer",
          "type": "Address"
        },
        {
          "name": "payee",
          "type": "Address"
        },
        {
          "name": "token",
          "type": "Address"
        },
        {
          "name": "amount",
          "type": "i128"
        }
      ]
    },
    "release_escrow": {
      "auth": "caller",
      "inputs": [
        {
          "name": "caller",
          "type": "Address"
        },
        {
          "name": "shipment_id",
          "type": "Symbol"
        }
      ]
    },
    "update_status": {
      "auth": "caller",
      "inputs": [
        {
          "name": "caller",
          "type": "Address"
        },
        {
          "name": "shipment_id",
          "type": "u64"
        },
        {
          "name": "new_status",
          "type": "ShipmentStatus"
        },
        {
          "name": "data_hash",
          "type": "BytesN<32>"
        }
      ],
      "errors": {
        "Unauthorized": 3,
        "ShipmentNotFound": 4,
        "InvalidStatus": 5,
        "InvalidHash": 6,
        "ShipmentFinalized": 38,
        "DuplicateAction": 41
      }
    },
    "confirm_delivery": {
      "auth": "receiver",
      "inputs": [
        {
          "name": "receiver",
          "type": "Address"
        },
        {
          "name": "shipment_id",
          "type": "Symbol"
        },
        {
          "name": "proof_hash",
          "type": "BytesN<32>"
        }
      ]
    },
    "create_shipment": {
      "auth": "sender",
      "inputs": [
        { "name": "sender", "type": "Address" },
        { "name": "receiver", "type": "Address" },
        { "name": "carrier", "type": "Address" },
        { "name": "data_hash", "type": "BytesN<32>" },
        { "name": "payment_milestones", "type": "Vec<i128>" },
        { "name": "deadline", "type": "u64" }
      ],
      "returns": "u64"
    },
    "raise_dispute": {
      "auth": "caller",
      "inputs": [
        { "name": "caller", "type": "Address" },
        { "name": "shipment_id", "type": "Symbol" },
        { "name": "reason_hash", "type": "BytesN<32>" }
      ]
    },
    "resolve_dispute": {
      "auth": "admin",
      "inputs": [
        { "name": "admin", "type": "Address" },
        { "name": "shipment_id", "type": "Symbol" },
        { "name": "outcome", "type": "Symbol" }
      ]
    },
    "add_company": {
      "auth": "admin",
      "inputs": [
        { "name": "admin", "type": "Address" },
        { "name": "company", "type": "Address" }
      ]
    },
    "add_carrier": {
      "auth": "admin",
      "inputs": [
        { "name": "admin", "type": "Address" },
        { "name": "company", "type": "Address" },
        { "name": "carrier", "type": "Address" }
      ]
    },
    "add_carrier_to_whitelist": {
      "auth": "admin",
      "inputs": [
        { "name": "admin", "type": "Address" },
        { "name": "company", "type": "Address" },
        { "name": "carrier", "type": "Address" }
      ]
    }
  },
  "enums": {
    "ShipmentStatus": {
      "encoding": "ScVal Vec[Symbol(variant)]",
      "variants": [
        "Created",
        "InTransit",
        "AtCheckpoint",
        "PartiallyDelivered",
        "Delivered",
        "Disputed",
        "Cancelled",
        "PartiallyRefunded"
      ]
    }
  }
}
